<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WestmarchBook.Desktop.ViewModels"
             x:Class="WestmarchBook.Desktop.Views.MainWindow"
             x:DataType="vm:MainViewModel"
             Title=""
             BackgroundColor="#1A1110"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="TopMenuButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#F5E8C7" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinimumHeightRequest" Value="28" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="TextColor" Value="#F5E8C7" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#3A1D22" />
                                    <Setter Property="TextColor" Value="#FFDF73" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="WindowCaptionBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2A1115" />
                <Setter Property="TextColor" Value="#FFF8E7" />
                <Setter Property="BorderColor" Value="#8B6914" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="WidthRequest" Value="34" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="MinimumWidthRequest" Value="34" />
                <Setter Property="MinimumHeightRequest" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2A1115" />
                                    <Setter Property="BorderColor" Value="#8B6914" />
                                    <Setter Property="TextColor" Value="#FFF8E7" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#8B2635" />
                                    <Setter Property="BorderColor" Value="#FFDF73" />
                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="ArpaActionBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2A1619" />
                <Setter Property="TextColor" Value="#F5E8C7" />
                <Setter Property="BorderColor" Value="#8B6914" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="MinimumHeightRequest" Value="32" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#8B2635" />
                                    <Setter Property="BorderColor" Value="#D4AF37" />
                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="ArpaDottedLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="#E8DCC4" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ArpaFieldBoxStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#211716" />
                <Setter Property="Stroke" Value="#7A6855" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="HeightRequest" Value="28" />
            </Style>

            <Style x:Key="ArpaDialogBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2B211F" />
                <Setter Property="TextColor" Value="#F5E8C7" />
                <Setter Property="BorderColor" Value="#9E8970" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="WidthRequest" Value="116" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="MinimumHeightRequest" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#3E2D2A" />
                                    <Setter Property="BorderColor" Value="#D4AF37" />
                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#8B2635" />
                                    <Setter Property="BorderColor" Value="#D4AF37" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Border Grid.Row="0"
                BackgroundColor="#3D1418"
                Stroke="#8B6914"
                StrokeThickness="1"
                Padding="12,4"
                HeightRequest="38">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Text="SISTEMA WESTMARCHBOOK COM VALIDADE TEMPORÁRIA"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontFamily="Georgia"
                       FontSize="18"
                       FontAttributes="Bold"
                       CharacterSpacing="1.4"
                       TextColor="#D4AF37" />

                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Button Text="_"
                            Style="{StaticResource WindowCaptionBtnStyle}"
                            Clicked="OnMinimizeWindowClicked" />
                    <Button Text="✕"
                            Style="{StaticResource WindowCaptionBtnStyle}"
                            Clicked="OnExitMenuClicked" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="#241316"
                Stroke="#6B4423"
                StrokeThickness="1"
                Padding="8,2"
                HeightRequest="34">
            <HorizontalStackLayout Spacing="4">
                <Button Text="Cadastros"
                        Style="{StaticResource TopMenuButtonStyle}"
                        Command="{Binding ToggleCadastrosSubmenuCommand}">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnCadastrosPointerEntered" />
                    </Button.GestureRecognizers>
                </Button>

                <Button Text="Manutenção"
                        Style="{StaticResource TopMenuButtonStyle}"
                        Clicked="OnGenericMenuClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnOtherMenuPointerEntered" />
                    </Button.GestureRecognizers>
                </Button>

                <Button Text="Relatórios"
                        Style="{StaticResource TopMenuButtonStyle}"
                        Clicked="OnGenericMenuClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnOtherMenuPointerEntered" />
                    </Button.GestureRecognizers>
                </Button>

                <Button Text="Utilitários"
                        Style="{StaticResource TopMenuButtonStyle}"
                        Clicked="OnGenericMenuClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnOtherMenuPointerEntered" />
                    </Button.GestureRecognizers>
                </Button>

                <Button Text="Ajuda"
                        Style="{StaticResource TopMenuButtonStyle}"
                        Clicked="OnGenericMenuClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnOtherMenuPointerEntered" />
                    </Button.GestureRecognizers>
                </Button>

                <Button Text="Sair"
                        Style="{StaticResource TopMenuButtonStyle}"
                        TextColor="#FFB4B4"
                        Clicked="OnExitMenuClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnOtherMenuPointerEntered" />
                    </Button.GestureRecognizers>
                </Button>
            </HorizontalStackLayout>
        </Border>

        <Border Grid.Row="2"
                BackgroundColor="#221215"
                Stroke="#8B6914"
                StrokeThickness="1"
                Padding="16,6"
                HeightRequest="104">
            <HorizontalStackLayout Spacing="16"
                                   HorizontalOptions="Center" 
                           VerticalOptions="Center">

                <Border x:Name="ShortcutF2Border"
                        BackgroundColor="#2E181C"
                        Stroke="#D4AF37"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        Padding="10,4"
                        WidthRequest="96"
                        HeightRequest="92">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchUserCommand}" />
                        <PointerGestureRecognizer PointerEntered="OnShortcutPointerEntered"
                                                  PointerExited="OnShortcutPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path WidthRequest="38"
                              HeightRequest="34"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              Stroke="#FFF8E7"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeLineCap="Round"
                              Data="M 24,6 A 7,7 0 1 1 17,13 L 6,24 L 6,29 L 11,29 L 11,25 L 15,25 L 15,21 L 20,16 A 7,7 0 0 1 24,6 Z M 25,10 A 2,2 0 1 0 25,14 A 2,2 0 1 0 25,10 Z" />
                        <Label Text="F2"
                               FontFamily="Georgia"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFFFFF" />
                        <Label Text="Senha"
                               FontFamily="Georgia"
                               FontSize="11"
                               HorizontalOptions="Center"
                               TextColor="#F5E8C7" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ShortcutF7Border"
                        BackgroundColor="#2E181C"
                        Stroke="#D4AF37"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        Padding="10,4"
                        WidthRequest="96"
                        HeightRequest="92">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenBooksModalCommand}" Tapped="OnBooksShortcutTapped" />
                        <PointerGestureRecognizer PointerEntered="OnShortcutPointerEntered"
                                                  PointerExited="OnShortcutPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path WidthRequest="38"
                              HeightRequest="34"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              Stroke="#FFF8E7"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeLineCap="Round"
                              Data="M 4,7 C 9,5 15,5 19,8 C 23,5 29,5 34,7 L 34,27 C 29,25 23,25 19,28 C 15,25 9,25 4,27 Z M 19,8 L 19,28 M 8,12 L 15,12 M 8,17 L 15,17 M 23,12 L 30,12 M 23,17 L 30,17" />
                        <Label Text="F7"
                               FontFamily="Georgia"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFFFFF" />
                        <Label Text="Livros"
                               FontFamily="Georgia"
                               FontSize="11"
                               HorizontalOptions="Center"
                               TextColor="#F5E8C7" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ShortcutF9Border"
                        BackgroundColor="#2E181C"
                        Stroke="#D4AF37"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        Padding="10,4"
                        WidthRequest="96"
                        HeightRequest="92">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenReadersModalCommand}" Tapped="OnReadersShortcutTapped" />
                        <PointerGestureRecognizer PointerEntered="OnShortcutPointerEntered"
                                                  PointerExited="OnShortcutPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path WidthRequest="38"
                              HeightRequest="34"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              Stroke="#FFF8E7"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeLineCap="Round"
                              Data="M 19,4 A 4,4 0 1 0 19,12 A 4,4 0 1 0 19,4 M 11,21 C 11,16 15,15 19,15 C 23,15 27,16 27,21 M 6,22 C 11,20 15,20 19,22 C 23,20 27,20 32,22 L 32,30 C 27,28 23,28 19,30 C 15,28 11,28 6,30 Z M 19,22 L 19,30" />
                        <Label Text="F9"
                               FontFamily="Georgia"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFFFFF" />
                        <Label Text="Leitor"
                               FontFamily="Georgia"
                               FontSize="11"
                               HorizontalOptions="Center"
                               TextColor="#F5E8C7" />
                    </VerticalStackLayout>
                </Border>

            </HorizontalStackLayout>
        </Border>

        <Border Grid.Row="2"
                Grid.RowSpan="2"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="8,0,0,0"
                WidthRequest="180"
                BackgroundColor="#241316"
                Stroke="#D4AF37"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 4"
                Padding="4"
                ZIndex="50"
                IsVisible="{Binding IsCadastrosSubmenuVisible}">
            <Border.GestureRecognizers>
                <PointerGestureRecognizer PointerExited="OnSubmenuPointerExited" />
            </Border.GestureRecognizers>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.85" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="2">
                <Button Text="📖  Livros (F7)"
                        Style="{StaticResource TopMenuButtonStyle}"
                        HorizontalOptions="Fill"
                        Command="{Binding OpenBooksModalCommand}" />
                <Button Text="👤  Leitores (F9)"
                        Style="{StaticResource TopMenuButtonStyle}"
                        HorizontalOptions="Fill"
                        Command="{Binding OpenReadersModalCommand}" />
            </VerticalStackLayout>
        </Border>

        <Grid x:Name="WorkspaceArea" Grid.Row="3" BackgroundColor="#1A1110">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnWorkspaceTapped" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 Opacity="0.35"
                                 InputTransparent="True">
                <Label Text="✦ WESTMARCH BOOK ✦"
                       HorizontalOptions="Center"
                       FontFamily="Georgia"
                       FontSize="26"
                       FontAttributes="Bold"
                       CharacterSpacing="3"
                       TextColor="#D4AF37" />
                <Label Text="{Binding WelcomeMessage}"
                       HorizontalOptions="Center"
                       FontFamily="Georgia"
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="#D8C7A5" />
            </VerticalStackLayout>

            <Grid BackgroundColor="#AA090405"
                  IsVisible="{Binding IsBooksListModalVisible}">

                <Border HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HeightRequest="680"
                        WidthRequest="1140"
                        BackgroundColor="#1C0E11"
                        Stroke="#D4AF37"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 6">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="28" Opacity="0.95" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,*,Auto,Auto">

                        <Border Grid.Row="0"
                                BackgroundColor="#8B2635"
                                Stroke="#D4AF37"
                                StrokeThickness="1"
                                Padding="14,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Livros"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontFamily="Georgia"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="#FBF6E9" />
                                <Button Grid.Column="1"
                                        Text="✕"
                                        BackgroundColor="Transparent"
                                        TextColor="#FBF6E9"
                                        BorderWidth="0"
                                        FontSize="14"
                                        Padding="8,2"
                                        MinimumHeightRequest="26"
                                        Command="{Binding CloseBooksModalCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="10,10,10,6"
                                BackgroundColor="#14090B"
                                Stroke="#6B4423"
                                StrokeThickness="1">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="75,*,190,170,115,90"
                                      BackgroundColor="#2A1519"
                                      Padding="10,6">
                                    <Label Grid.Column="0" Text="CÓDIGO" FontFamily="Georgia" FontSize="11" FontAttributes="Bold" TextColor="#D4AF37" />
                                    <Label Grid.Column="1" Text="TÍTULO DO LIVRO" FontFamily="Georgia" FontSize="11" FontAttributes="Bold" TextColor="#D4AF37" />
                                    <Label Grid.Column="2" Text="PUBLICADORA" FontFamily="Georgia" FontSize="12" FontAttributes="Bold" TextColor="#D4AF37" />
                                    <Label Grid.Column="3" Text="AUTOR(ES)" FontFamily="Georgia" FontSize="11" FontAttributes="Bold" TextColor="#D4AF37" />
                                    <Label Grid.Column="4" Text="PUBLICAÇÃO" FontFamily="Georgia" FontSize="11" FontAttributes="Bold" TextColor="#D4AF37" />
                                    <Label Grid.Column="5" Text="STATUS" FontFamily="Georgia" FontSize="11" FontAttributes="Bold" TextColor="#D4AF37" />
                                </Grid>

                                <CollectionView Grid.Row="1"
                                                ItemsSource="{Binding Books}"
                                                SelectionMode="Single"
                                                SelectedItem="{Binding SelectedBook}">
                                    <CollectionView.EmptyView>
                                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6" Padding="24">
                                            <Label Text="Nenhum livro listado na sessão atual."
                                                   FontFamily="Georgia"
                                                   FontSize="13"
                                                   FontAttributes="Italic"
                                                   TextColor="#8A7761"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Clique em 'Incluir' para cadastrar um novo livro ou busque pelo Código abaixo."
                                                   FontFamily="Georgia"
                                                   FontSize="11"
                                                   TextColor="#6E5A48"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BookListItemViewModel">
                                            <Border BackgroundColor="Transparent"
                                                    Stroke="#2D171B"
                                                    StrokeThickness="1"
                                                    Padding="10,6">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal" />
                                                        <VisualState Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="#4A1A22" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Grid ColumnDefinitions="75,*,190,170,115,90">
                                                    <Label Grid.Column="0" Text="{Binding Id}" FontFamily="Georgia" FontSize="12" TextColor="#D4AF37" />
                                                    <Label Grid.Column="1" Text="{Binding Title}" FontFamily="Georgia" FontSize="12" TextColor="#F5E8C7" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="2" Text="{Binding PublisherName}" FontFamily="Georgia" FontSize="13" TextColor="#DDD0B8" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="3" Text="{Binding AuthorName}" FontFamily="Georgia" FontSize="12" TextColor="#DDD0B8" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="4" Text="{Binding PublicationDate, StringFormat='{0:dd/MM/yyyy}'}" FontFamily="Georgia" FontSize="12" TextColor="#BFA57A" />
                                                    <Label Grid.Column="5" Text="{Binding StatusText}" FontFamily="Georgia" FontSize="11" FontAttributes="Bold" TextColor="#85C989" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="10,0,10,6"
                                BackgroundColor="#241316"
                                Stroke="#6B4423"
                                StrokeThickness="1"
                                Padding="16,12"
                                MinimumHeightRequest="78">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0"
                                           Text="{Binding SelectedBook.Description, StringFormat='Descrição: {0}', TargetNullValue='Descrição: (Selecione um livro)'}"
                                           FontFamily="Georgia"
                                           FontSize="13"
                                           TextColor="#F5E8C7"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding SelectedBook.GenresSummary, StringFormat='Gêneros: {0}'}"
                                           FontFamily="Georgia"
                                           FontSize="11"
                                           TextColor="#D4AF37"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding SelectedBook.LanguagesSummary, StringFormat='Linguagens: {0}'}"
                                           FontFamily="Georgia"
                                           FontSize="11"
                                           TextColor="#BFA57A" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ListStatusMessage}"
                                           IsVisible="{Binding HasListStatusMessage}"
                                           FontFamily="Georgia"
                                           FontSize="11"
                                           FontAttributes="Italic"
                                           TextColor="#FFDF73" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Grid Grid.Row="3"
                              BackgroundColor="#160B0D"
                              RowDefinitions="Auto,Auto,Auto"
                              Padding="14,8,14,12">
                            <BoxView Grid.Row="0"
                                     HeightRequest="1"
                                     Color="#6B4423"
                                     HorizontalOptions="Fill"
                                     Margin="0,0,0,10" />

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*,*,*,*"
                                  ColumnSpacing="10"
                                  Margin="0,0,0,10">
                                <Button Grid.Column="0"
                                        Text="Incluir"
                                        Style="{StaticResource ArpaActionBtnStyle}"
                                        HorizontalOptions="Fill"
                                        Command="{Binding OpenIncludeBookModalCommand}" />

                                <Button Grid.Column="1"
                                        Text="Alterar"
                                        Style="{StaticResource ArpaActionBtnStyle}"
                                        HorizontalOptions="Fill"
                                        Command="{Binding OpenEditBookModalCommand}" />

                                <Button Grid.Column="2"
                                        Text="Ativar"
                                        Style="{StaticResource ArpaActionBtnStyle}"
                                        HorizontalOptions="Fill"
                                        Command="{Binding ActivateBookCommand}" />

                                <Button Grid.Column="3"
                                        Text="Desativar"
                                        Style="{StaticResource ArpaActionBtnStyle}"
                                        HorizontalOptions="Fill"
                                        Command="{Binding DeactivateBookCommand}" />

                                <Button Grid.Column="4"
                                        Text="Deletar"
                                        Style="{StaticResource ArpaActionBtnStyle}"
                                        HorizontalOptions="Fill"
                                        TextColor="#FFB4B4"
                                        Clicked="OnDeleteBookClicked" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="Auto,*,Auto,150"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="Cons. Código / Título:"
                                       VerticalOptions="Center"
                                       FontFamily="Georgia"
                                       FontSize="12"
                                       TextColor="#D4AF37" />

                                <Border Grid.Column="1" Style="{StaticResource WestmarchInputBorderStyle}">
                                    <Entry Style="{StaticResource WestmarchEntryStyle}"
                                           FontSize="12"
                                           MinimumHeightRequest="28"
                                           Text="{Binding SearchText}"
                                           Placeholder="Digite o ID ou título..."
                                           ReturnType="Search"
                                           Completed="OnSearchBookCompleted" />
                                </Border>

                                <Button Grid.Column="2"
                                        Text="🔍 Buscar"
                                        Style="{StaticResource ArpaActionBtnStyle}"
                                        Padding="16,6"
                                        Command="{Binding SearchBookCommand}" />

                                <Button Grid.Column="3"
                                        Text="(ESC) Fechar"
                                        Style="{StaticResource ArpaActionBtnStyle}"
                                        HorizontalOptions="Fill"
