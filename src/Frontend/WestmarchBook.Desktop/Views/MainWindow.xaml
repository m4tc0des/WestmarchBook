                                                    Text="Incluir"
                                                    Style="{StaticResource ArpaDialogBtnStyle}"
                                                    WidthRequest="90"
                                                    HeightRequest="32"
                                                    MinimumHeightRequest="32"
                                                    FontSize="12"
                                                    Command="{Binding AddGenreCommand}" />
                                            <Border Grid.Column="3"
                                                    Style="{StaticResource ArpaFieldBoxStyle}"
                                                    HeightRequest="32"
                                                    BackgroundColor="#150E0D"
                                                    Padding="6,2">
                                                <ScrollView Orientation="Horizontal" VerticalScrollBarVisibility="Never">
                                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SelectedGenres}"
                                                                           Spacing="6"
                                                                           VerticalOptions="Center">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:GenreOptionItem">
                                                                <Border BackgroundColor="#2B211F"
                                                                        Stroke="#9E8970"
                                                                        StrokeThickness="1"
                                                                        StrokeShape="RoundRectangle 2"
                                                                        Padding="6,2">
                                                                    <HorizontalStackLayout Spacing="5">
                                                                        <Label Text="{Binding Name}"
                                                                               FontFamily="Consolas"
                                                                               FontSize="11"
                                                                               TextColor="#F5E8C7"
                                                                               VerticalOptions="Center" />
                                                                        <Label Text="✕"
                                                                               FontSize="10"
                                                                               TextColor="#FFB4B4"
                                                                               VerticalOptions="Center">
                                                                            <Label.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=RemoveGenreCommand}"
                                                                                                      CommandParameter="{Binding .}" />
                                                                            </Label.GestureRecognizers>
                                                                        </Label>
                                                                    </HorizontalStackLayout>
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </HorizontalStackLayout>
                                                </ScrollView>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="155,200,92,*" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="Linguagem.........:"
                                                   Style="{StaticResource ArpaDottedLabelStyle}" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource ArpaFieldBoxStyle}"
                                                    HeightRequest="32"
                                                    Padding="2,0">
                                                <Picker ItemsSource="{Binding AvailableLanguages}"
                                                        SelectedItem="{Binding SelectedLanguageToAdd}"
                                                        TextColor="#F5E8C7"
                                                        BackgroundColor="Transparent"
                                                        FontFamily="Georgia"
                                                        FontSize="12" />
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Text="Incluir"
                                                    Style="{StaticResource ArpaDialogBtnStyle}"
                                                    WidthRequest="90"
                                                    HeightRequest="32"
                                                    MinimumHeightRequest="32"
                                                    FontSize="12"
                                                    Command="{Binding AddLanguageCommand}" />
                                            <Border Grid.Column="3"
                                                    Style="{StaticResource ArpaFieldBoxStyle}"
                                                    HeightRequest="32"
                                                    BackgroundColor="#150E0D"
                                                    Padding="6,2">
                                                <ScrollView Orientation="Horizontal" VerticalScrollBarVisibility="Never">
                                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SelectedLanguages}"
                                                                           Spacing="6"
                                                                           VerticalOptions="Center">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:LanguageOptionItem">
                                                                <Border BackgroundColor="#2B211F"
                                                                        Stroke="#9E8970"
                                                                        StrokeThickness="1"
                                                                        StrokeShape="RoundRectangle 2"
                                                                        Padding="6,2">
                                                                    <HorizontalStackLayout Spacing="5">
                                                                        <Label Text="{Binding Name}"
                                                                               FontFamily="Consolas"
                                                                               FontSize="11"
                                                                               TextColor="#F5E8C7"
                                                                               VerticalOptions="Center" />
                                                                        <Label Text="✕"
                                                                               FontSize="10"
                                                                               TextColor="#FFB4B4"
                                                                               VerticalOptions="Center">
                                                                            <Label.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=RemoveLanguageCommand}"
                                                                                                      CommandParameter="{Binding .}" />
                                                                            </Label.GestureRecognizers>
                                                                        </Label>
                                                                    </HorizontalStackLayout>
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </HorizontalStackLayout>
                                                </ScrollView>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                                <Label Text="{Binding FormErrorMessage}"
                                       IsVisible="{Binding HasFormError}"
                                       TextColor="#FFB4B4"
                                       FontFamily="Georgia"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <HorizontalStackLayout Grid.Row="3"
                                               HorizontalOptions="Center"
                                               Spacing="160"
                                               Padding="0,16,0,16">
                            <Button Text="OK"
                                    Style="{StaticResource ArpaDialogBtnStyle}"
                                    WidthRequest="130"
                                    HeightRequest="36"
                                    Command="{Binding SaveBookCommand}"
                                    IsEnabled="{Binding IsFormNotLoading}" />

                            <Button Text="Fechar"
                                    Style="{StaticResource ArpaDialogBtnStyle}"
                                    WidthRequest="130"
                                    HeightRequest="36"
                                    Command="{Binding CloseBookFormModalCommand}"
                                    IsEnabled="{Binding IsFormNotLoading}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="QuickEntityModalGrid"
                  BackgroundColor="#AA040203"
                  IsVisible="{Binding IsQuickEntityModalVisible}">

                <Border HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="420"
                        BackgroundColor="#1A1110"
                        Stroke="#9E8970"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 3">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.98" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="#B81D33"
                              ColumnDefinitions="*,Auto"
                              Padding="12,5">
                            <Label Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding QuickEntityModalTitle}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontFamily="Georgia"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Button Grid.Column="1"
                                    Text="✕"
                                    BackgroundColor="#2B211F"
                                    TextColor="#F5E8C7"
                                    BorderColor="#7A6855"
                                    BorderWidth="1"
                                    CornerRadius="2"
                                    FontSize="12"
                                    WidthRequest="26"
                                    HeightRequest="22"
                                    MinimumWidthRequest="26"
                                    MinimumHeightRequest="22"
                                    Padding="0"
                                    Command="{Binding CloseQuickEntityModalCommand}" />
                        </Grid>
                        <VerticalStackLayout Padding="18,16" Spacing="10">
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="6">
                                <Label Grid.Column="0"
                                       Text="Nome....:"
                                       Style="{StaticResource ArpaDottedLabelStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource ArpaFieldBoxStyle}">
                                    <Entry x:Name="QuickEntityNameEntry"
                                           Style="{StaticResource WestmarchEntryStyle}"
                                           FontSize="13"
                                           MinimumHeightRequest="26"
                                           Text="{Binding QuickEntityName}"
                                           ReturnType="Done"
                                           Completed="OnQuickEntityCompleted" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding QuickEntityError}"
                                   IsVisible="{Binding HasQuickEntityError}"
                                   TextColor="#FFB4B4"
                                   FontFamily="Georgia"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />

                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="32" Margin="0,8,0,0">
                                <Button Text="OK"
                                        Style="{StaticResource ArpaDialogBtnStyle}"
                                        Command="{Binding SaveQuickEntityCommand}"
                                        IsEnabled="{Binding IsQuickEntityNotLoading}" />

                                <Button Text="Fechar"
                                        Style="{StaticResource ArpaDialogBtnStyle}"
                                        Command="{Binding CloseQuickEntityModalCommand}"
                                        IsEnabled="{Binding IsQuickEntityNotLoading}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Grid x:Name="CopyRegistrationModalGrid"
                  BackgroundColor="#AA040203"
                  IsVisible="{Binding IsCopyModalVisible}">

                <Border HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="460"
                        BackgroundColor="#1A1110"
                        Stroke="#9E8970"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 3">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.98" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">
                        <Grid BackgroundColor="#B81D33"
                              ColumnDefinitions="*,Auto"
                              Padding="12,5">
                            <Label Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="INCLUSÃO DE EXEMPLARES"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontFamily="Georgia"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Button Grid.Column="1"
                                    Text="✕"
                                    BackgroundColor="#2B211F"
                                    TextColor="#F5E8C7"
                                    BorderColor="#7A6855"
                                    BorderWidth="1"
                                    CornerRadius="2"
                                    FontSize="12"
                                    WidthRequest="26"
                                    HeightRequest="22"
                                    MinimumWidthRequest="26"
                                    MinimumHeightRequest="22"
                                    Padding="0"
                                    Command="{Binding CloseCopyModalCommand}" />
                        </Grid>
                        <VerticalStackLayout Padding="18,16" Spacing="12">
                            <Label Text="Informe o número de registro de cada cópia física:"
                                   FontFamily="Georgia"
                                   FontSize="12"
                                   FontAttributes="Italic"
                                   TextColor="#DDD0B8" />
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="6">
                                <Label Grid.Column="0"
                                       Text="Nº Registro..:"
                                       Style="{StaticResource ArpaDottedLabelStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource ArpaFieldBoxStyle}">
                                    <Entry x:Name="CopyRegistrationNumberEntry"
                                           Style="{StaticResource WestmarchEntryStyle}"
                                           FontSize="13"
                                           MinimumHeightRequest="26"
                                           Placeholder="Ex: REG-001, 1024..."
                                           Text="{Binding CopyRegistrationNumberInput}"
                                           ReturnType="Next"
                                           Completed="OnCopyRegistrationCompleted" />
                                </Border>
                            </Grid>
                            <Border BackgroundColor="{Binding CopyFeedbackBackgroundColor}"
                                    Stroke="{Binding CopyFeedbackStrokeColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="8,6"
                                    IsVisible="{Binding HasCopyFeedbackMessage}">
                                <Label Text="{Binding CopyFeedbackMessage}"
                                       TextColor="{Binding CopyFeedbackTextColor}"
                                       FontFamily="Georgia"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="{Binding CopySummaryText}"
                                   TextColor="#D4AF37"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="24" Margin="0,6,0,0">
                                <Button Text="Registrar"
                                        Style="{StaticResource ArpaDialogBtnStyle}"
                                        WidthRequest="110"
                                        Command="{Binding AddCopyRegistrationNumberCommand}" />

                                <Button Text="Fechar"
                                        Style="{StaticResource ArpaDialogBtnStyle}"
                                        WidthRequest="110"
                                        Command="{Binding CloseCopyModalCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="4"
                BackgroundColor="#14090B"
                Stroke="#8B6914"
                StrokeThickness="1"
                Padding="16,8"
                HeightRequest="42">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <HorizontalStackLayout Grid.Column="0" Spacing="14" VerticalOptions="Center">
                    <Label Text="✦ WESTMARCH"
                           FontFamily="Georgia"
                           FontSize="15"
                           FontAttributes="Bold"
                           CharacterSpacing="1.8"
                           TextColor="#D4AF37"
                           VerticalOptions="Center" />

                    <Label FontFamily="Georgia" FontSize="12" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Usuário: " TextColor="#BFA57A" />
                                <Span Text="{Binding UserName}" FontAttributes="Bold" TextColor="#FFF8E7" />
                                <Span Text=" | Servidor: " TextColor="#BFA57A" />
                                <Span Text="{Binding ServerName}" FontAttributes="Bold" TextColor="#FFF8E7" />
                                <Span Text=" | Base: " TextColor="#BFA57A" />
                                <Span Text="{Binding DatabaseName}" FontAttributes="Bold" TextColor="#FFF8E7" />
                                <Span Text=" | Versão: " TextColor="#BFA57A" />
                                <Span Text="{Binding AppVersion}" FontAttributes="Bold" TextColor="#D4AF37" />
                                <Span Text=" |" TextColor="#BFA57A" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Label Text="{Binding CurrentDateTime}"
                           FontFamily="Georgia"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#FFF8E7"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
