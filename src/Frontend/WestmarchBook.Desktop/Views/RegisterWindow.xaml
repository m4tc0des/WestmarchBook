<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WestmarchBook.Desktop.ViewModels"
             x:Class="WestmarchBook.Desktop.Views.RegisterWindow"
             x:DataType="vm:RegisterViewModel"
             Title="Westmarch Book - Registro"
             BackgroundColor="#14090B"
             NavigationPage.HasNavigationBar="False">

    <Border Margin="14"
            BackgroundColor="#1C0E11"
            Stroke="#8B6914"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 8">
        <Border.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="20" Opacity="0.9" />
        </Border.Shadow>

        <Border Margin="4"
                BackgroundColor="Transparent"
                Stroke="#D4AF37"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 6"
                Padding="32,20">

            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="4">
                    <Label Text="✦ WESTMARCH BOOK ✦"
                           HorizontalOptions="Center"
                           FontFamily="Georgia"
                           FontSize="18"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           TextColor="#D4AF37" />

                    <Label Text="REGISTRO DE NOVO AVENTUREIRO"
                           HorizontalOptions="Center"
                           FontFamily="Georgia"
                           FontSize="10"
                           FontAttributes="Italic"
                           CharacterSpacing="1"
                           TextColor="#BFA57A" />

                    <BoxView HeightRequest="1"
                             WidthRequest="200"
                             Color="#8B6914"
                             HorizontalOptions="Center"
                             Margin="0,8,0,10" />
                </VerticalStackLayout>

                <Label Grid.Row="1"
                       Text="Inscreva seu nome nas crônicas do reino:"
                       FontFamily="Georgia"
                       FontSize="12"
                       FontAttributes="Italic"
                       TextColor="#DDD0B8"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <VerticalStackLayout Grid.Row="2" Spacing="10" VerticalOptions="Center">

                    <VerticalStackLayout>
                        <Label Text="NOME" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource WestmarchInputBorderStyle}">
                            <Entry x:Name="UserNameTextBox"
                                   Style="{StaticResource WestmarchEntryStyle}"
                                   FontSize="13"
                                   Text="{Binding UserName}"
                                   Placeholder="Digite seu nome..."
                                   ReturnType="Next"
                                   Focused="OnInputFocused"
                                   Unfocused="OnInputUnfocused"
                                   Completed="OnUserNameCompleted" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="E-MAIL" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource WestmarchInputBorderStyle}">
                            <Entry x:Name="EmailTextBox"
                                   Style="{StaticResource WestmarchEntryStyle}"
                                   FontSize="13"
                                   Text="{Binding Email}"
                                   Placeholder="Digite seu e-mail..."
                                   Keyboard="Email"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   ReturnType="Next"
                                   Focused="OnInputFocused"
                                   Unfocused="OnInputUnfocused"
                                   Completed="OnEmailCompleted" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="SENHA" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource WestmarchInputBorderStyle}">
                            <Entry x:Name="PasswordTextBox"
                                   Style="{StaticResource WestmarchEntryStyle}"
                                   FontSize="13"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   Placeholder="Mínimo 8 caracteres, maiúscula, minúscula e símbolo..."
                                   ReturnType="Done"
                                   Focused="OnInputFocused"
                                   Unfocused="OnInputUnfocused"
                                   Completed="OnPasswordCompleted" />
                        </Border>
                    </VerticalStackLayout>

                    <Border BackgroundColor="#3D1418"
                            Stroke="#E57373"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            Padding="10,6"
                            IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#FFB4B4"
                               FontSize="11"
                               FontFamily="Georgia"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <Label Text="Registrando..."
                           TextColor="#D4AF37"
                           FontSize="11"
                           FontFamily="Georgia"
                           FontAttributes="Italic"
                           HorizontalOptions="Center"
                           IsVisible="{Binding IsLoading}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Spacing="8" Margin="0,10,0,0">
                    <Button Style="{StaticResource WestmarchButtonStyle}"
                            FontSize="13"
                            Padding="0,10"
                            Text="Registrar"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsNotLoading}" />

                    <Button Style="{StaticResource WestmarchSecondaryButtonStyle}"
                            Text="VOLTAR"
                            Command="{Binding BackCommand}"
                            IsEnabled="{Binding IsNotLoading}" />

                    <Label Text="« Um passo de cada vez até a montanha »"
                           HorizontalOptions="Center"
                           FontFamily="Georgia"
                           FontSize="10"
                           FontAttributes="Italic"
                           TextColor="#8A7761"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Border>
</ContentPage>
