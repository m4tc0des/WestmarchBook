<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WestmarchBook.Desktop.App">
    <Application.Resources>
        <ResourceDictionary>
            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#D4AF37" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="WestmarchInputBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#241316" />
                <Setter Property="Stroke" Value="#6B4423" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
                <Setter Property="Padding" Value="6,0" />
            </Style>

            <Style x:Key="WestmarchEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#F5E8C7" />
                <Setter Property="PlaceholderColor" Value="#7A6A58" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="MinimumHeightRequest" Value="36" />
            </Style>

            <Style x:Key="WestmarchButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#8B2635" />
                <Setter Property="TextColor" Value="#FBF6E9" />
                <Setter Property="BorderColor" Value="#D4AF37" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="0,12" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#8B2635" />
                                    <Setter Property="TextColor" Value="#FBF6E9" />
                                    <Setter Property="BorderColor" Value="#D4AF37" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#A83244" />
                                    <Setter Property="BorderColor" Value="#FFDF73" />
                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#661924" />
                                    <Setter Property="BorderColor" Value="#B8860B" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="WestmarchSecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#1F1215" />
                <Setter Property="TextColor" Value="#D4AF37" />
                <Setter Property="BorderColor" Value="#8B6914" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1F1215" />
                                    <Setter Property="TextColor" Value="#D4AF37" />
                                    <Setter Property="BorderColor" Value="#8B6914" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2E181C" />
                                    <Setter Property="BorderColor" Value="#D4AF37" />
                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="WestmarchLinkButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#D4AF37" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Italic" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#2A1418" />
                                    <Setter Property="TextColor" Value="#FFDF73" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
